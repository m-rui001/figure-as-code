#import "@preview/cetz:0.4.2": canvas, draw
#set page(width: auto, height: auto, margin: 10pt)
#set text(font: "Arial", size: 10pt)

// Signals 2022, DOI 10.3390/signals3020020, Figure 10, CC BY 4.0.
// Separate labels from the original densely packed LTspice symbol geometry.
#canvas({
  import draw: *
  let ink = rgb("22227a")
  let wire(..pts) = draw.line(..pts, stroke: 0.65pt + black)
  let symbol(..pts, close: false) = draw.line(..pts, close: close, stroke: 0.8pt + ink)
  let label(p, t) = content(p, t)
  let node(x, y) = rect((x - 0.08, y - 0.08), (x + 0.08, y + 0.08),
    fill: ink, stroke: none)
  let resistor(x, y, vertical: false) = {
    let pts = ((x, y),)
    for i in range(1, 7) {
      let d = if calc.odd(i) { 0.18 } else { -0.18 }
      pts.push(if vertical { (x + d, y - i / 7) } else { (x + i / 7, y + d) })
    }
    pts.push(if vertical { (x, y - 1) } else { (x + 1, y) })
    symbol(..pts)
  }
  let ground(x, y) = {
    wire((x, y), (x, y - 0.25))
    symbol((x - 0.25, y - 0.25), (x + 0.25, y - 0.25), (x, y - 0.55), close: true)
  }
  let source(x, y, name, value) = {
    circle((x, y), radius: 0.5, stroke: 0.8pt + ink)
    label((x, y + 0.28), [+])
    label((x, y - 0.28), [−])
    label((x + 0.85, y + 0.55), name)
    label((x + 0.95, y - 0.50), value)
  }

  // Buck power stage, including the floating gate-drive source and parasitics.
  wire((1.5, 18), (3.2, 18))
  wire((1.5, 18), (1.5, 16.1))
  source(1.5, 15.6, [], [19])
  label((0.15, 16.65), [Vsource])
  wire((1.5, 15.1), (1.5, 13.8), (22, 13.8), (22, 15.6))
  label((1.5, 18.55), [Vin])
  symbol((3.2, 18), (3.2, 17.52), (3.58, 17.52))
  symbol((4.8, 18), (4.8, 17.52), (4.42, 17.52))
  symbol((3.7, 17.52), (3.7, 17.85), (4.3, 17.85), (4.3, 17.52))
  symbol((4.02, 17.82), (4.02, 17.55), (3.87, 17.68), (4.02, 17.82))
  symbol((3.2, 17.34), (4.8, 17.34))
  label((4, 18.55), [M1])
  wire((4.8, 18), (12.9, 18))
  wire((4.8, 17.34), (4.8, 16.35))
  source(4.8, 15.85, [E1], [1])
  wire((4.8, 15.35), (4.8, 14.65), (7.3, 14.65), (7.3, 18))
  node(7.3, 18)
  wire((4.38, 16.12), (3, 16.12), (3, 9.25))
  label((4.04, 16.22), [+])
  wire((4.38, 15.58), (3.9, 15.58), (3.9, 13.8))
  label((4.06, 15.44), [−])
  node(3.9, 13.8)
  wire((11.4, 18), (11.4, 16))
  symbol((11.12, 15.5), (11.68, 15.5), (11.4, 16), close: true)
  symbol((11.05, 16.13), (11.05, 16), (11.75, 16), (11.75, 15.87))
  wire((11.4, 15.5), (11.4, 13.8))
  label((10.78, 16.45), [D1])
  node(11.4, 18)
  node(11.4, 13.8)
  resistor(12.9, 18)
  label((13.4, 18.58), [Rl])
  label((13.4, 17.43), [0.1])
  wire((13.9, 18), (14.6, 18))
  for i in range(3) {
    arc((14.6 + i * 0.48, 18), start: 180deg, stop: 0deg, radius: 0.24, stroke: 0.8pt + ink)
  }
  wire((16.04, 18), (22, 18), (22, 16.6))
  label((15.3, 18.6), [L1])
  label((15.3, 17.43), [200µ])
  label((22, 18.55), [Vout])
  resistor(22, 16.6, vertical: true)
  label((22.65, 16.25), [R2])
  label((22.65, 15.72), [1])
  wire((17.4, 18), (17.4, 16.75))
  symbol((17.08, 16.75), (17.72, 16.75))
  symbol((17.08, 16.55), (17.72, 16.55))
  wire((17.4, 16.55), (17.4, 15.25))
  resistor(17.4, 15.25, vertical: true)
  wire((17.4, 14.25), (17.4, 13.8))
  label((18.05, 17.05), [C1])
  label((18.5, 16.42), [220µ])
  label((18.12, 15), [ESR])
  label((18.12, 14.48), [0.2])
  node(17.4, 18)
  node(17.4, 13.8)
  node(7.3, 13.8)
  ground(7.3, 13.8)

  // PI amplifier with series RC feedback and a five-volt reference.
  symbol((13.2, 7.35), (13.2, 8.65), (14.6, 8), close: true)
  label((13.42, 8.36), [−])
  label((13.42, 7.66), [+])
  label((14.55, 8.83), [U2])
  wire((9.9, 8.35), (10.3, 8.35))
  label((9.38, 8.35), [Vout])
  resistor(10.3, 8.35)
  label((10.8, 8.94), [R1])
  label((10.8, 7.80), [10k])
  wire((11.3, 8.35), (13.2, 8.35))
  wire((12.1, 8.35), (12.1, 11.55), (13.1, 11.55))
  resistor(13.1, 11.55)
  label((13.6, 12.12), [R3])
  label((13.6, 10.98), [1k])
  wire((14.1, 11.55), (16.35, 11.55))
  symbol((16.35, 11.22), (16.35, 11.88))
  symbol((16.55, 11.22), (16.55, 11.88))
  label((16.45, 12.2), [C2])
  label((16.45, 10.9), [470nF])
  wire((16.55, 11.55), (20, 11.55), (20, 4.5), (3.35, 4.5), (3.35, 7.75))
  wire((14.6, 8), (20, 8))
  node(12.1, 8.35)
  node(20, 8)
  label((20.75, 8), [vctrl])
  wire((13.9, 8.33), (13.9, 9.25))
  label((13.9, 9.65), [Vmais])
  wire((13.9, 7.67), (13.9, 6.75))
  label((13.9, 6.35), [Vmenos])
  label((14.12, 8.44), [+])
  label((14.12, 7.48), [−])
  wire((13.2, 7.65), (11.35, 7.65), (11.35, 6.5))
  source(11.35, 6, [V4], [5])
  ground(11.35, 5.5)
  label((12.2, 4.93), [Rser=0])

  // Comparator and its independent ramp and supply sources.
  symbol((2.3, 7.75), (3.7, 7.75), (3, 9.25), close: true)
  label((2.63, 7.98), [−])
  label((3.35, 7.98), [+])
  label((2.3, 9.3), [U1])
  wire((2.65, 7.75), (2.65, 5.6), (2.1, 5.6), (2.1, 3.05))
  wire((2.65, 8.5), (2.1, 8.5))
  label((1.45, 8.5), [Vmais])
  wire((3.35, 8.5), (3.9, 8.5))
  label((4.65, 8.5), [Vmenos])
  source(2.1, 2.55, [V1], [])
  ground(2.1, 2.05)
  label((6.6, 1.25), [PULSE(0 10 0 9.9u 0.1u 0u 10u)])
  for (x, name, net, value) in ((15, [V2], [Vmais], [10]), (19, [V3], [Vmenos], [−0.2])) {
    source(x, 1.8, name, value)
    wire((x, 2.3), (x, 3.15))
    label((x, 3.55), net)
    ground(x, 1.3)
    label((x + 0.95, 0.65), [Rser=0])
  }
})
