      "typ": "typ/conduction-stage-algorithm.typ",
      "labels": {
        "Conduction stage": 1,
        "Discretization of equations (1) and (3)": 1
      },
      "code_lines": [
        "def conduction_state(t0,PA,Vin,Rs,il0,Rl,L,vc0,ESR,C,R):",
        "    K1 = C + ESR*C/R",
        "    KA = - ESR*C/(K1*L) - (Rl+Rs)/L",
        "    KB = ESR*C/(R*K1*L) - 1/L",
        "    vc = vc0*(1 - PA/(R*K1)) + il0*(PA/K1)",
        "    il = Vin*PA/L + il0*(1 + KA*PA) + vc0*(KB*PA)",
        "    ic = C*(vc - vc0)/PA",
        "    vo = ESR*ic + vc",
        "    t = t0 + PA",
        "    return [t,il,ic,vc,vo]"
      ]
    },
