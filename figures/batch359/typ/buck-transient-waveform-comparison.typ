#canvas({
  import draw: *
  let axes = (
    ("vO (V)", ((0.046, "0"), (0.547, "5"))),
    ("iL (A)", ((0.041, "0"), (0.456, "5"), (0.866, "10"))),
    ("iC (A)", ((0.208, "0.0"), (0.596, "2.5"), (0.991, "5.0"))),
    ("vctrl (V)", ((0.048, "0.0"), (0.46, "2.5"), (0.873, "5.0"))),
  )
  let grid = 0.45pt + rgb("bbbbbb")
  for (col, title) in ("LTspice", "Python").enumerate() {
    content((3.2 + col * 10.1, 27.6), text(size: 13pt, title))
  }
  for (row, (axis, ticks)) in axes.enumerate() {
    for col in range(2) {
      let x = col * 10.1
      let y = (3 - row) * 7.1
      let w = 6.4
      let h = 5
      for (frac, label) in ticks {
        if row == 2 and col == 1 and label == "5.0" { continue }
        let yy = y + frac * h
        line((x, yy), (x + w, yy), stroke: grid)
        line((x - 0.14, yy), (x, yy), stroke: 0.65pt + black)
        content((x - 0.26, yy), label, anchor: "east")
      }
      line((x + w / 2, y), (x + w / 2, y + h), stroke: grid)
      let points = traces.at(2 * row + col).map(((u, v)) => (x + u * w, y + v * h))
      line(..points, stroke: 1.05pt + rgb("247baa"))
      rect((x, y), (x + w, y + h), stroke: 0.7pt + black)
      for (frac, label) in ((0, "0.000"), (0.5, "0.005"), (1, "0.010")) {
        let xx = x + frac * w
        line((xx, y), (xx, y - 0.15), stroke: 0.65pt + black)
        content((xx, y - 0.43), label)
      }
      content((x + w / 2, y - 1.02), [time (s)])
      content((x - 1.95, y + h / 2), vertical(axis))
    }
  }
})
