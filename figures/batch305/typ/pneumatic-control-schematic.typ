#set page(width: auto, height: auto, margin: 6pt)
#set text(font: ("Arial", "Segoe UI"), size: 10pt)
#import "@preview/cetz:0.4.2": canvas, draw
// 图名：The current control schematics of the system
// 来源：Actuators 2025, 14(2), 252, Figure 11；DOI: 10.3390/act14020252
// 结构：上方系统框图（PC—PCB—Tactile sensor array—Soft pneumatic actuator）
// 下方虚线框为 Mobile pneumatic control platform：黄色电子元件、青色气动元件
// 细箭头=导线，粗实线=气动管路，Bluetooth 虚线仅由 PCB 指向 PC
// 左下气动链为外气源→限压→单向→过滤调压→压力罐；真空罐经分压器反馈给单片机
#let trot(a, body) = rotate(a, body)
#canvas(length: 0.75pt, {
  import draw: *
  let H = 1030
  let q(x, y) = (x, H - y)
  let yel = rgb("#ffe830")
  let cyn = rgb("#29a8dc")
  let gry = rgb("#d9d9d9")
  let lw = 0.85pt
  let mk = (end: "stealth", fill: black, scale: 0.45)
  let bmk = (start: "stealth", end: "stealth", fill: black, scale: 0.45)
  let bd(x, y, w, h, t, f: white, fs: 9pt) = {
    rect(q(x, y + h), q(x + w, y), fill: f, stroke: lw)
    content(q(x + w / 2, y + h / 2), text(size: fs, t))
  }
  let lg(x, y, t, fs: 8pt, a: "center") = content(q(x, y), text(size: fs, t), anchor: a)
  let pl(pts, st: lw, m: mk) = line(..pts.map(p => q(p.at(0), p.at(1))), stroke: st, mark: m)
  let wl(pts) = pl(pts)
  let ws(pts) = pl(pts, st: (paint: black, thickness: lw, dash: "dashed"), m: bmk)
  let pn(pts) = pl(pts, st: 2pt)
  let pv(pts) = pl(pts, st: 2pt, m: none)

